# RapidAPI key for ExerciseDB + YouTube (same key for both). Set in .env locally and in Netlify env vars.
# Get key: https://rapidapi.com/justin-WFnsXH_t6/api/exercisedb — subscribe, then copy key.
# Also subscribe to youtube-search-and-download.p.rapidapi.com for video search.
REACT_APP_RAPIDAPI_KEY=your_rapidapi_key_here

# Optional: YouTube channel ID for video search (default used if not set).
# REACT_APP_YOUTUBE_CHANNEL_ID=UChPvQ8hfrSW1EAbtBWjis0g
